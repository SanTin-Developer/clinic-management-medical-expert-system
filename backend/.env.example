APP_NAME="RoyalCare Clinic"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@clinic.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Token / session lifetime (minutes). 480 = 8 hours.
SANCTUM_EXPIRATION=480
SESSION_LIFETIME=480
SESSION_EXPIRE_ON_CLOSE=false
# Force HTTPS-only cookies in production.
SESSION_SECURE_COOKIE=null
SESSION_SAME_SITE=lax

# Frontend SPA origin (used in verification / password reset email links).
FRONTEND_URL=http://localhost:5173

# Comma-separated browser origins allowed to call the API (CORS).
# Includes the admin dashboard (5173) and the standalone public website (5174).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# OTP / trusted-device two-factor authentication. Disabled by default.
AUTH_OTP_ENABLED=false
AUTH_OTP_LENGTH=6
AUTH_OTP_EXPIRE_MINUTES=10
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN=60
AUTH_TRUSTED_DEVICE_DAYS=30
AUTH_DEVICE_COOKIE_NAME=clinic_trusted_device
AUTH_ENFORCE_TRUSTED_DEVICE=false
AUTH_REQUIRE_VERIFIED_EMAIL=false
AUTH_PASSWORD_MIN=8

# TOTP two-factor authentication (authenticator apps). When AUTH_2FA_MANDATORY
# is true, staff accounts that have enrolled in TOTP must present a valid code
# when signing in, and staff without it are prompted/blocked until they enroll.
# Disabled by default so existing deployments and demo accounts keep working.
AUTH_2FA_MANDATORY=false
AUTH_2FA_ISSUER="${APP_NAME}"
AUTH_2FA_DIGITS=6
AUTH_2FA_PERIOD=30
AUTH_2FA_WINDOW=1
AUTH_2FA_CHALLENGE_EXPIRE_MINUTES=10
AUTH_2FA_CHALLENGE_MAX_ATTEMPTS=5
AUTH_2FA_RECOVERY_CODES=8

# Progressive account lockout after repeated failed passwords. The login route
# is always rate limited; this adds a per-account cooldown as well.
AUTH_LOCKOUT_ENABLED=false
AUTH_LOCKOUT_MAX_ATTEMPTS=10
AUTH_LOCKOUT_DECAY_MINUTES=15

# Staff invitation links.
AUTH_INVITATION_EXPIRE_HOURS=72
AUTH_INVITATION_PATH=/accept-invitation

# Step-up authorization TTL (minutes) and email-change code settings.
AUTH_STEP_UP_TTL_MINUTES=10
# When true, staff with TOTP enrolled must also enter an authenticator code to
# complete a step-up (e.g. suspending a user). Non-enrolled accounts are unaffected.
AUTH_STEP_UP_REQUIRE_TWO_FACTOR=false
AUTH_EMAIL_CHANGE_EXPIRE_MINUTES=15
AUTH_EMAIL_CHANGE_MAX_ATTEMPTS=5

# Email the account owner when a critical security event occurs (e.g. lockout).
AUTH_SECURITY_ALERTS_ENABLED=true

# Patient document storage: local (default), s3 or cloudinary.
DOCUMENTS_DISK=local
DOCUMENTS_MAX_SIZE_KB=10240

# Announcement poster/thumbnail storage: cloudinary (default), public or local.
# Falls back to the public disk when Cloudinary credentials are not configured.
ANNOUNCEMENT_POSTER_DISK=cloudinary

# Upload antivirus scanner: null (dev/test) or clamav.
FILE_SCANNER_DRIVER=null
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=10

# Cloudinary (optional; requires CLOUDINARY_API_SECRET for signed uploads).
# CLOUDINARY_FOLDER is the root-level folder that receives every upload (patient
# documents, announcement posters and website media). Use a folder path without
# a leading slash; nested folders are appended automatically.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER="Clinic Management System and Medical Expert systems"
CLOUDINARY_SECURE=true

# API documentation (Scramble). UI: /docs/api, OpenAPI JSON: /docs/api.json.
# The docs are restricted to the local environment by default; elsewhere only
# authenticated administrators (the `viewApiDocs` gate) may access them.
API_VERSION=1.0.0
SCRAMBLE_DEV_TOOLS="${APP_DEBUG}"

# Aggregate report caching (JSON endpoints). Disable for always-fresh data.
REPORTS_CACHE_ENABLED=true
REPORTS_CACHE_TTL=300

# Internal medical expert system (FastAPI) reached over the private network.
EXPERT_SYSTEM_URL=http://expert-system:8001
EXPERT_SYSTEM_TIMEOUT=5
EXPERT_SYSTEM_CONNECT_TIMEOUT=2
EXPERT_SYSTEM_API_KEY=

# Staff communication — realtime WebSockets (Laravel Reverb).
# Generate app credentials with `php artisan reverb:start` / see the Reverb docs.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SCALING_ENABLED=false

# Staff communication — Telegram notifications/linking.
# Create a bot with @BotFather, then set the token and a random webhook secret.
# Delivery mode: pick exactly ONE. Webhook requires a public HTTPS URL; polling
# (telegram:poll) is used otherwise. The poller disables itself when the webhook
# is enabled, so the two never run together.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_ENABLED=false
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_POLLING_ENABLED=true
TELEGRAM_POLL_TIMEOUT=30
TELEGRAM_POLL_SLEEP=1
TELEGRAM_LINK_TOKEN_TTL=15
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_TIMEOUT=10

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
