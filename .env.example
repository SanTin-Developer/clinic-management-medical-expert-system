APP_NAME="Clinic Management & Medical Expert System"

POSTGRES_DB=clinic_db
POSTGRES_USER=clinic_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=5173
# Host port published for the standalone public website (React/Vite) dev server.
WEBSITE_PORT=5174
# Host port published for the Laravel Reverb websocket server.
REVERB_PORT=8080

# Internal medical expert system (FastAPI). In production set
# EXPERT_SYSTEM_API_KEY to a strong random secret and share it with the
# backend; never commit the real value.
EXPERT_SYSTEM_URL=http://expert-system:8001
# Must be at least as long as EXPERT_SYSTEM_REQUEST_TIMEOUT_SECONDS below.
EXPERT_SYSTEM_TIMEOUT=15
EXPERT_SYSTEM_CONNECT_TIMEOUT=2
EXPERT_SYSTEM_API_KEY=
EXPERT_SYSTEM_LOG_LEVEL=INFO
EXPERT_RULES_CACHE_TTL_SECONDS=60
EXPERT_SYSTEM_REQUEST_TIMEOUT_SECONDS=15
EXPERT_AUDIT_ENABLED=false