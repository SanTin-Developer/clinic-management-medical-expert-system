# Expert system (FastAPI) service configuration.
# Copy to `.env` for local runs, or supply these as environment variables.
# Never commit real secrets; `.env` is git-ignored.

# SQLAlchemy database URL. Required. Use the Docker service name `postgres`
# when running via docker compose, or `localhost` for host development.
DATABASE_URL=postgresql+psycopg://clinic_user:change_me@postgres:5432/clinic_db

# Optional internal shared secret. When set, POST /evaluate requires the
# `X-Internal-Api-Key` header. Set to a strong random value in production.
EXPERT_SYSTEM_API_KEY=

# Root log level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# Connection pool and timeout tuning (values shown are the defaults).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=5000

# In-process rule cache TTL in seconds (0 disables caching). Cache is
# invalidated by TTL; set 0 when rules change frequently.
EXPERT_RULES_CACHE_TTL_SECONDS=60

# Hard application-level per-request timeout in seconds (must be > 0).
EXPERT_SYSTEM_REQUEST_TIMEOUT_SECONDS=15

# Evaluation audit trail (opt-in). When enabled, each /evaluate call persists
# the submitted symptom IDs and matched rule codes. This stores symptom
# selections, so keep it disabled unless your privacy policy permits it.
EXPERT_AUDIT_ENABLED=false

# Reported service version.
APP_VERSION=1.0.0
