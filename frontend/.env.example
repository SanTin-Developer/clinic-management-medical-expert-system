# Base URL of the Laravel API (no trailing slash).
# Must stay in sync with the backend route prefix `api/v1`.
VITE_API_URL=http://localhost:8000/api/v1

# Public website origin (standalone `website/` app) — used by "View website".
# In production set this to the deployed public site URL.
VITE_PUBLIC_SITE_URL=http://localhost:5174

# Laravel Reverb (websocket) — must match backend REVERB_* settings.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http